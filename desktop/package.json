{
  "name": "bug-detective",
  "productName": "Bug Detective",
  "version": "0.1.0",
  "description": "A desktop game where developers practice debugging a real app.",
  "author": "Bug Detective",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "electron:install": "install-electron --no",
    "prepare:resources": "node tools/prepare-resources.ts",
    "build:stages": "node tools/build-stage-packages.ts",
    "predev": "npm run prepare:resources && npm run build:stages",
    "dev": "electron-vite dev",
    "build": "npm run prepare:resources && npm run build:stages && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "postinstall": "npm ci --prefix tools/lint --no-audit --no-fund",
    "prepare": "cd .. && husky desktop/.husky",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node tools/lint/node_modules/eslint/bin/eslint.js . --fix",
    "pretest:integration": "npm run prepare:resources && npm run build:stages",
    "verify:push": "npm run typecheck && npm test && npm run test:integration"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "tar-stream": "3.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tar-stream": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "husky": "9.1.7",
    "i18next": "26.5.11",
    "lint-staged": "17.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "bugDetective": {
    "contentRepository": "pleaobraga/supportdesk-qa",
    "contentRelease": "latest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": "node tools/lint/node_modules/eslint/bin/eslint.js --fix"
  }
}
